# Database Configuration (Docker PostGIS)
POSTGRES_USER=spatial_user
POSTGRES_PASSWORD=spatial_password_change_me
POSTGRES_DB=spatial_twin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Static Assets Path
STATIC_ASSETS_DIR=./static

# Verified local video reconstruction (one backend worker; no --reload during jobs)
PIPELINE_JOBS_DIR=./output/phase_d/jobs
PIPELINE_MAX_UPLOAD_MB=512
PIPELINE_MAX_FRAMES=24
PIPELINE_IMAGE_WIDTH=640
PIPELINE_RENDER_WIDTH=320
PIPELINE_TRAIN_ITERATIONS=600
PIPELINE_MAX_GAUSSIANS=40000
PIPELINE_DEVICE=cuda
PIPELINE_TIMEOUT_SECONDS=7200

# OpenRouter AI API Configuration
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl:free
